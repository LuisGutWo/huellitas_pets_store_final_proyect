# Copia este archivo como .env.local y completa los valores.
# El sitio funciona SIN ninguna de estas variables: el catálogo, el carrito y
# los guardados no dependen de servicios externos. Lo que falta se degrada con
# un mensaje explícito en pantalla, nunca con una pantalla en blanco.

# --- Firebase Auth (ingresar / crear cuenta / recuperar contraseña) ---
# Sin estas variables las pantallas de cuenta lo informan y el resto del sitio
# sigue operando como invitado.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- EmailJS (formulario de contacto) ---
# Sin estas variables el formulario valida igual y, al enviar, deriva a WhatsApp.
NEXT_PUBLIC_EMAILJS_SERVICE=
NEXT_PUBLIC_EMAILJS_TEMPLATE=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=
